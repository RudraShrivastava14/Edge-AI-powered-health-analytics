# Copy to .env and fill in from infrastructure/.outputs.json.
# These are environment-specific, not secret — but .env stays gitignored anyway.
VITE_AWS_REGION=ap-south-1
VITE_API_ENDPOINT=https://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com
VITE_USER_POOL_ID=ap-south-1_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_POLL_INTERVAL_MS=5000
